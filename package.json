{
  "name": "beyond-markdown",
  "version": "1.0.0",
  "description": "D&D Beyond Public and Owned content to LLM/AI Optimized Markdown",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "gui"
  ],
  "scripts": {
    "beyond-markdown": "node index.js",
    "library": "node src/scripts/library.js",
    "extract": "node src/scripts/bulk_extract.js",
    "fetch": "node src/scripts/api_fetcher.js",
    "munch": "node src/scripts/bulk_muncher.js",
    "stitch": "node src/scripts/stitcher.js",
    "stitch-repo": "node src/scripts/repo_stitcher.js",
    "compile": "node src/scripts/character_compiler.js",
    "convert": "node src/scripts/rules_converter.js",
    "format": "prettier --write \"**/*.js\"",
    "lint": "eslint src index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrewLucey/beyond-markdown.git"
  },
  "author": "Drew Lucey",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.4.2",
    "electron": "^42.3.3",
    "inquirer": "^14.0.2",
    "marked": "^11.1.1",
    "prettier": "^3.8.3",
    "readline": "^1.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
